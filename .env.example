# PostgreSQL
# - ในเครื่อง: ใส่ URL เดียวกันทั้ง 2 ตัว
# - Neon: DATABASE_URL = URL แบบ pooled (มี -pooler), DIRECT_URL = URL แบบตรง (ไม่มี -pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/santi_audio"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/santi_audio"

# ค่าลับสำหรับเซ็นคุกกี้ล็อกอิน (สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# บัญชีผู้ขายเริ่มต้น (ใช้สร้างครั้งแรกเท่านั้น รหัสผ่านจะถูกเข้ารหัสก่อนเก็บในฐานข้อมูล)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# ลิงก์ Facebook เริ่มต้น (แก้ได้ภายหลังในหน้า ตั้งค่าร้าน)
FACEBOOK_URL="https://www.facebook.com/"

# โฟลเดอร์เก็บรูป (บน Railway ใช้ /data/uploads ซึ่งเป็น Volume)
UPLOAD_DIR="./uploads"

# ที่เก็บรูปบน Cloudinary (ใช้ตอน deploy บน Vercel — ถ้าไม่ตั้ง รูปจะเก็บใน UPLOAD_DIR)
# ดูได้ที่ Cloudinary Console → API Keys → "API environment variable"
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

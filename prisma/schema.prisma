generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // ใช้ต่อฐานข้อมูลตรง (ไม่ผ่าน pooler) ตอนรัน migration — บน Neon คือ URL ที่ไม่มีคำว่า -pooler
  directUrl = env("DIRECT_URL")
}

enum CategoryType {
  PRODUCT
  BLOG
}

enum ProductStatus {
  AVAILABLE
  SOLD
}

model Category {
  id        Int          @id @default(autoincrement())
  name      String
  slug      String
  type      CategoryType
  icon      String       @default("box")
  sortOrder Int          @default(0)
  products  Product[]
  posts     Post[]
  createdAt DateTime     @default(now())

  @@unique([type, slug])
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  price       Int
  condition   String         @default("")
  defects     String         @default("")
  description String         @default("")
  status      ProductStatus  @default(AVAILABLE)
  categoryId  Int?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  isMain    Boolean @default(false)
  sortOrder Int     @default(0)
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
}

model Setting {
  id          Int     @id @default(1)
  shopName    String  @default("Santi Audio")
  tagline     String  @default("เครื่องเสียงและอุปกรณ์อิเล็กทรอนิกส์มือสอง")
  description String  @default("")
  facebookUrl String  @default("")
  logo        String?
  heroImage   String?
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
